{
  "name": "ai-for-the-old",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "A local-first DeepSeek task workspace for older adults.",
  "author": "GuoCalix",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node app/server/index.mjs",
    "build": "vite build",
    "desktop:build": "npm run build",
    "desktop:dir": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "desktop:mac": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --mac dmg --publish never",
    "desktop:win": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --win nsis --publish never",
    "desktop": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --publish never",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:desktop:closed-loop": "node scripts/desktop-closed-loop.mjs"
  },
  "build": {
    "appId": "com.guocalix.aifortheold",
    "productName": "AI for the old",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "app/server/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    },
    "artifactName": "AI-for-the-old-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
